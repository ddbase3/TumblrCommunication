	"type": "library",
	"require": {
		"php": ">=8.1",
		"tumblr/tumblr": "^0.4.2",
		"league/oauth1-client": "^1.11"
	},
	"autoload": {
		"psr-4": {
			"TumblrCommunication\\": "src/"
		}
	},
	"authors": [
		{
			"name": "Daniel Dahme",
			"email": "info@base3.de"
		}
	],
	"minimum-stability": "stable",
